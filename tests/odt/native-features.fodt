<text:list text:style-name="List_20_1"><text:list-item><text:p text:style-name="Text_20_body">Маркер</text:p><text:list><text:list-item><text:p text:style-name="Text_20_body">Кружок</text:p><text:list><text:list-item><text:p text:style-name="Text_20_body">Квадрат</text:p></text:list-item></text:list></text:list-item></text:list></text:list-item><text:list-header><text:p text:style-name="Text_20_body">Заголовок списка без маркера</text:p></text:list-header><text:list-item><text:p text:style-name="Text_20_body">Снова маркер</text:p></text:list-item></text:list>
