<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DocxToPdf</RootNamespace>
    <AssemblyName>docx2pdf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Словари переносов (шаблоны Лианга из словарей LibreOffice, см. Hyphenation/licenses) -->
    <EmbeddedResource Include="Hyphenation/*.dic.gz" LogicalName="DocxToPdf.Hyphenation.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
